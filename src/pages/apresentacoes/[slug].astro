---
import cases from '../../data/cases.json';
import {local} from '../../data/site';
import baseCss from '../../styles/deck-base.css?raw';
export function getStaticPaths(){return cases.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
const desktop=project.gallery.find(asset=>asset.width>asset.height)||project.gallery[0];
const mobile=project.gallery.find(asset=>asset.height>asset.width);
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>Apresentação — {project.title} {project.subtitle}</title><style is:inline set:html={baseCss}/><style is:inline set:html={`@font-face{font-family:Quicksand;src:url('${local('fonts/quicksand-variable.ttf')}')} `}/>
<style is:inline>
:root{--stage-bg:#10272c;--slide-bg:#ebece5}*{box-sizing:border-box}body{font-family:Quicksand,sans-serif;color:#123e46}.slide{padding:90px 110px;transition:opacity .6s ease,visibility .6s}.slide h1,.slide h2{font-size:66px;font-weight:500;letter-spacing:-2px;margin:0;max-width:1200px}.slide p{font-size:25px;line-height:1.6;max-width:760px}.slide-index{position:absolute;right:110px;top:105px;font-size:22px}.devices{position:absolute;left:180px;right:170px;top:290px;bottom:150px;display:flex;align-items:center;justify-content:center;gap:90px;perspective:1800px}.computer{width:1200px;position:relative;transform:rotateY(-5deg);transition:transform 1s;flex-shrink:0}.screen{padding:18px;border-radius:28px;background:#16353b;box-shadow:0 26px 55px #123e4624}.screen img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px}.computer:after{content:'';display:block;height:22px;background:#718887;border-radius:2px 2px 50% 50%;margin:0 -45px}.phone{width:280px;flex-shrink:0;background:#17383e;padding:10px;border-radius:42px;box-shadow:0 24px 45px #123e4630;transform:rotate(5deg)}.phone img{display:block;width:100%;border-radius:32px;aspect-ratio:430/932;object-fit:cover}.active .computer{transform:rotateY(0)}.single-shot{position:absolute;top:230px;left:110px;right:110px;bottom:100px;display:flex;align-items:center;justify-content:center}.devices>.single-shot{inset:0}.single-shot img{height:100%;width:100%;object-fit:contain;border-radius:24px}.deck-controls{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:10px;align-items:center;background:#123e46;color:#f7f5ef;border-radius:30px;padding:4px 10px;z-index:10;font:14px Quicksand,sans-serif}.deck-controls button{width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:inherit;cursor:pointer;font-size:22px}.deck-controls button:focus-visible{outline:2px solid #b97866}.deck-controls button:disabled{opacity:.3;cursor:default}@media(prefers-reduced-motion:reduce){.slide,.computer{transition:none}}
</style></head><body><div class="deck-viewport"><div class="deck-stage">
<section class="slide active" aria-label="Visão geral"><h1>{project.title} — {project.subtitle}</h1><p>{project.type==='web'?'Uma experiência em diferentes telas.':project.summary}</p><div class="devices">{project.type==='web'?<><div class="computer"><div class="screen"><img src={local(`images/${desktop.image}`)} alt={desktop.alt}/></div></div>{mobile&&<div class="phone"><img src={local(`images/${mobile.image}`)} alt={mobile.alt}/></div>}</>:<div class="single-shot"><img src={local(`images/${desktop.image}`)} alt={desktop.alt}/></div>}</div></section>
{project.gallery.map((asset,i)=><section class="slide" aria-hidden="true"><h2>{asset.alt}</h2><span class="slide-index">{String(i+2).padStart(2,'0')}</span><div class="single-shot"><img src={local(`images/${asset.image}`)} alt={asset.alt} loading="lazy"/></div></section>)}
</div></div><nav class="deck-controls" aria-label="Apresentação do projeto"><button type="button" data-prev aria-label="Slide anterior">←</button><span data-count aria-live="polite"></span><button type="button" data-next aria-label="Próximo slide">→</button></nav>
<script is:inline>
(()=>{const stage=document.querySelector('.deck-stage'),slides=[...document.querySelectorAll('.slide')],prev=document.querySelector('[data-prev]'),next=document.querySelector('[data-next]');let current=0;function fit(){const scale=Math.min(innerWidth/1920,innerHeight/1080);stage.style.transform=`translate(${(innerWidth-1920*scale)/2}px, ${(innerHeight-1080*scale)/2}px) scale(${scale})`;}function show(n){current=Math.max(0,Math.min(slides.length-1,n));slides.forEach((s,i)=>{s.classList.toggle('active',i===current);s.setAttribute('aria-hidden',String(i!==current));});prev.disabled=current===0;next.disabled=current===slides.length-1;document.querySelector('[data-count]').textContent=`${current+1} / ${slides.length}`;}prev.onclick=()=>show(current-1);next.onclick=()=>show(current+1);addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();show(current+(e.key==='ArrowRight'?1:-1));}});addEventListener('resize',fit);fit();show(0);})();
</script></body></html>

